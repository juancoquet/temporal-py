# Copy to `.env` for local development. Values already set in the environment are never overridden.

# Temporal — control-plane connection for the workers. The endpoint is a URL with a scheme, host,
# and port; the client derives the host:port gRPC target from it. For a local dev server
# (`temporal server start-dev`) the defaults below work; in a deployed setting point these at your
# Temporal Cloud namespace, e.g. grpcs://<namespace>.<account>.tmprl.cloud:7233 (worker TLS /
# API-key auth is a separate deployment concern, out of scope for this template).
TEMPORAL_ENDPOINT=grpc://localhost:7233
TEMPORAL_NAMESPACE=default
